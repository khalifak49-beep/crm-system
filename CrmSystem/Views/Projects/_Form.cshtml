@model ProjectFormViewModel
@using CrmSystem.Models.Enums
@{
    var isEdit = Model.ProjectId.HasValue;
}
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.ProjectId" method="post" novalidate>
    <div class="modal-header">
        <h2 class="modal-title">@(isEdit ? L["Projects.Edit"] : L["Projects.New"])</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert-glass mb-3" role="alert"></div>
        <input type="hidden" asp-for="RowVersion" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="ClientId" class="form-label required"></label>
                <select asp-for="ClientId" data-remote="@Url.Action("Clients", "Lookup")" data-placeholder="@L["Common.SearchCompany"]" required>
                    @if (Model.ClientId.HasValue) { <option value="@Model.ClientId" selected>@Model.ClientName</option> }
                </select>
                <span asp-validation-for="ClientId"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ProjectName" class="form-label required"></label>
                <input asp-for="ProjectName" class="form-control" />
                <span asp-validation-for="ProjectName"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ProjectStatus" class="form-label"></label>
                <select asp-for="ProjectStatus" class="form-select" asp-items="@(UiHelpers.EnumOptions<ProjectStatus>(L, "ProjectStatus", Model.ProjectStatus))"></select>
            </div>
            <div class="col-8 col-md-5">
                <label asp-for="ProjectValue" class="form-label"></label>
                <input asp-for="ProjectValue" class="form-control" type="number" step="0.001" min="0" dir="ltr" />
                <span asp-validation-for="ProjectValue"></span>
            </div>
            <div class="col-4 col-md-3">
                <label asp-for="Currency" class="form-label"></label>
                <input asp-for="Currency" class="form-control" maxlength="3" dir="ltr" />
                <span asp-validation-for="Currency"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Probability" class="form-label"></label>
                <div class="d-flex align-items-center gap-2">
                    <input asp-for="Probability" type="range" class="form-range" min="0" max="100" step="5" oninput="this.nextElementSibling.textContent=this.value+'%'" />
                    <span class="tabular fw-semibold" style="min-width:3.5ch">@Model.Probability%</span>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="ExpectedStartDate" class="form-label"></label>
                <input asp-for="ExpectedStartDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
            </div>
            <div class="col-6 col-md-4">
                <label asp-for="ExpectedEndDate" class="form-label"></label>
                <input asp-for="ExpectedEndDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
                <span asp-validation-for="ExpectedEndDate"></span>
            </div>
            <div class="col-12">
                <label asp-for="ProjectDescription" class="form-label"></label>
                <textarea asp-for="ProjectDescription" class="form-control" rows="3"></textarea>
            </div>
            @if (Model.CanAssign)
            {
                <div class="col-md-6">
                    <label asp-for="AssignedToId" class="form-label"></label>
                    <select asp-for="AssignedToId" data-remote="@Url.Action("Employees", "Lookup")" data-placeholder="@L["Common.Select"]">
                        @if (!string.IsNullOrEmpty(Model.AssignedToId)) { <option value="@Model.AssignedToId" selected>@Model.AssignedToName</option> }
                    </select>
                </div>
            }
            <div class="col-md-6" data-closed-only>
                <label asp-for="ClosedDate" class="form-label"></label>
                <input asp-for="ClosedDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" />
            </div>
            <div class="col-12" data-lost-only>
                <label asp-for="LostReason" class="form-label"></label>
                <input asp-for="LostReason" class="form-control" />
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light-fill" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
        <button type="submit" class="btn btn-primary">@L["Common.Save"]</button>
    </div>
    <script>
        (function () {
            const form = document.currentScript.closest("form");
            const status = form.querySelector("#ProjectStatus");
            const sync = () => {
                const v = Number(status.value);
                form.querySelector("[data-closed-only]").hidden = !(v === 6 || v === 7);
                form.querySelector("[data-lost-only]").hidden = v !== 7;
            };
            status.addEventListener("change", sync);
            sync();
        })();
    </script>
</form>
