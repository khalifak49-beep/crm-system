@model CrmSystem.Services.ReportPage
@using System.Globalization
@{
    Layout = null;
    var arabic = AppCultures.IsArabic;
    var culture = arabic ? AppCultures.ArabicCulture : AppCultures.EnglishCulture;
    string Format(string kind, object? value)
    {
        if (value == null) return "—";
        return value switch
        {
            DateOnly d => d.ToString("dd/MM/yyyy"),
            TimeOnly t => t.ToString("hh:mm tt", culture),
            DateTime dt => dt.ToString("dd/MM/yyyy hh:mm tt", culture),
            _ when kind.StartsWith("status:") => L[$"{kind[7..]}.{value}"].Value,
            decimal m when kind == "money" => m.ToString("N3", CultureInfo.InvariantCulture),
            _ when kind == "percent" => value + "%",
            _ when kind == "number" => Convert.ToDecimal(value).ToString("N0", CultureInfo.InvariantCulture),
            _ => value.ToString() ?? ""
        };
    }
}
<!DOCTYPE html>
<html lang="@(arabic ? "ar" : "en")" dir="@(arabic ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title · @ViewBag.Company</title>
    <style>
        @@font-face { font-family: "CRM Arabic"; src: url("@Url.Content("~/lib/ibm-plex-sans-arabic/ibm-plex-sans-arabic-arabic-400-normal.woff2")") format("woff2"); unicode-range: U+0600-06FF, U+FB50-FDFF, U+FE70-FEFC; }
        @@font-face { font-family: "CRM Arabic"; font-weight: 700; src: url("@Url.Content("~/lib/ibm-plex-sans-arabic/ibm-plex-sans-arabic-arabic-700-normal.woff2")") format("woff2"); unicode-range: U+0600-06FF, U+FB50-FDFF, U+FE70-FEFC; }
        @@page { size: A4 landscape; margin: 12mm; }
        * { box-sizing: border-box; }
        body { font-family: "CRM Arabic", -apple-system, "Segoe UI", Tahoma, Arial, sans-serif; color: #1c1c1e; margin: 0; padding: 16px; font-size: 11px; }
        header { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid #007aff; padding-bottom: 8px; margin-bottom: 10px; }
        h1 { font-size: 18px; margin: 0 0 4px; }
        .meta { color: #6b6b70; font-size: 10px; line-height: 1.6; }
        .company { font-weight: 700; color: #007aff; font-size: 13px; }
        table { width: 100%; border-collapse: collapse; }
        th { background: #eaf2fe; text-align: start; padding: 6px; font-size: 10px; border-bottom: 1px solid #b9cdea; }
        td { padding: 5px 6px; border-bottom: 1px solid #e5e5ea; vertical-align: top; white-space: pre-line; }
        td.num, th.num { text-align: end; font-variant-numeric: tabular-nums; }
        tr { page-break-inside: avoid; }
        thead { display: table-header-group; }
        footer { margin-top: 10px; color: #6b6b70; font-size: 10px; }
        .hint { background: #fff4e5; color: #8a4b00; border-radius: 8px; padding: 10px 12px; margin-bottom: 12px; font-size: 12px; }
        @@media print { .hint, .noprint { display: none; } body { padding: 0; } }
    </style>
</head>
<body>
    @if (ViewBag.Pdf == true)
    {
        <div class="hint">@L["Reports.PdfHint"]</div>
    }
    <header>
        <div>
            <div class="company">@ViewBag.Company</div>
            <h1>@ViewBag.Title</h1>
            <div class="meta">
                @foreach (var line in (List<string>)ViewBag.FilterLines) { <div>@line</div> }
            </div>
        </div>
        <div class="meta">@L["Reports.Rows"]: @Model.Total</div>
    </header>

    <table>
        <thead>
            <tr>
                @foreach (var c in Model.Columns)
                {
                    <th class="@(c.Kind is "number" or "money" or "percent" ? "num" : "")">@L[c.TitleKey]</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="@Model.Columns.Count" style="text-align:center;padding:20px">@L["Grid.Empty"]</td></tr>
            }
            @foreach (var item in Model.Items)
            {
                <tr>
                    @foreach (var c in Model.Columns)
                    {
                        <td class="@(c.Kind is "number" or "money" or "percent" ? "num" : "")">@Format(c.Kind, item.GetValueOrDefault(c.Key))</td>
                    }
                </tr>
            }
        </tbody>
    </table>
    <footer>@ViewBag.Company · @(((DateTime)ViewBag.GeneratedAt).ToString("dd/MM/yyyy hh:mm tt", culture))</footer>

    <script>
        window.addEventListener("load", function () { setTimeout(function () { window.print(); }, 300); });
    </script>
</body>
</html>
