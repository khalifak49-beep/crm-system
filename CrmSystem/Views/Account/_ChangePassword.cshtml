@model ChangePasswordViewModel
<form asp-controller="Account" asp-action="ChangePassword" method="post" novalidate autocomplete="off">
    <div class="modal-header">
        <h2 class="modal-title">@L["Account.ChangePassword"]</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert-glass mb-3" role="alert"></div>
        <div class="mb-3">
            <label asp-for="CurrentPassword" class="form-label required"></label>
            <input asp-for="CurrentPassword" class="form-control" dir="ltr" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label required"></label>
            <input asp-for="NewPassword" class="form-control" dir="ltr" autocomplete="new-password" />
            <span asp-validation-for="NewPassword"></span>
        </div>
        <div class="mb-2">
            <label asp-for="ConfirmPassword" class="form-label required"></label>
            <input asp-for="ConfirmPassword" class="form-control" dir="ltr" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword"></span>
        </div>
        <div class="form-text">@L["Users.PasswordRules"]</div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light-fill" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
        <button type="submit" class="btn btn-primary">@L["Common.Save"]</button>
    </div>
</form>
