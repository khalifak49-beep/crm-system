@model ContactFormViewModel
@{
    var isEdit = Model.ContactId.HasValue;
}
<form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.ContactId" method="post" novalidate>
    <div class="modal-header">
        <h2 class="modal-title">@(isEdit ? L["Contacts.Edit"] : L["Contacts.New"])</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Common.Close"]"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert-glass mb-3" role="alert"></div>
        <input type="hidden" asp-for="RowVersion" />
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="ClientId" class="form-label required"></label>
                <select asp-for="ClientId" data-remote="@Url.Action("Clients", "Lookup")" data-placeholder="@L["Common.SearchCompany"]" required>
                    @if (Model.ClientId.HasValue) { <option value="@Model.ClientId" selected>@Model.ClientName</option> }
                </select>
                <span asp-validation-for="ClientId"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label required"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="JobTitle" class="form-label"></label>
                <input asp-for="JobTitle" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Department" class="form-label"></label>
                <input asp-for="Department" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" dir="ltr" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" type="tel" dir="ltr" />
            </div>
            <div class="col-md-6">
                <label asp-for="Mobile" class="form-label"></label>
                <input asp-for="Mobile" class="form-control" type="tel" dir="ltr" />
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
            <div class="col-md-6">
                <label class="form-switch-card">
                    <input asp-for="IsPrimary" class="form-check-input" type="checkbox" role="switch" />
                    <span><span class="fw-semibold d-block">@L["Contacts.IsPrimary"]</span><span class="form-text">@L["Contacts.PrimaryHint"]</span></span>
                </label>
            </div>
            <div class="col-md-6">
                <label class="form-switch-card">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                    <span class="fw-semibold">@L["Field.Active"]</span>
                </label>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light-fill" data-bs-dismiss="modal">@L["Common.Cancel"]</button>
        <button type="submit" class="btn btn-primary">@L["Common.Save"]</button>
    </div>
</form>
