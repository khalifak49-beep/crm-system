@* Layout for pages without the sidebar (login) *@
@inject IAppSettings AppSettings
@{
    var settings = await AppSettings.GetAsync();
    var arabic = AppCultures.IsArabic;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!DOCTYPE html>
<html lang="@(arabic ? "ar" : "en")" dir="@(arabic ? "rtl" : "ltr")">
<head>
    <title>@ViewData["Title"] · @settings.CompanyDisplayName(arabic)</title>
    <partial name="_Head" />
</head>
<body>
    <div class="auth-top">
        <form asp-controller="Language" asp-action="Set" method="post" class="m-0">
            <input type="hidden" name="lang" value="@(arabic ? "en" : "ar")" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="pill-btn glass" lang="@(arabic ? "en" : "ar")" aria-label="@L["Top.SwitchLanguageLabel"]">
                <i class="f7-icons sm" aria-hidden="true">globe</i> @L["Top.SwitchLanguage"]
            </button>
        </form>
    </div>

    <main class="auth-wrap">
        @RenderBody()
    </main>

    <div id="toastStack" class="toast-stack" aria-live="polite"></div>

    <partial name="_AppConfig" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
