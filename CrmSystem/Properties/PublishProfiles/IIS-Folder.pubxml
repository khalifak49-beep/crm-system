<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish for IIS:  dotnet publish CrmSystem\CrmSystem.csproj -p:PublishProfile=IIS-Folder
  Output: ..\publish\CrmSystem  (framework-dependent: the server needs the .NET 10 Hosting Bundle)
  DeleteExistingFiles = false so uploaded logos / import files are never wiped on redeploy.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <Configuration>Release</Configuration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>..\publish\CrmSystem\</PublishDir>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>
  </PropertyGroup>
</Project>
