<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the CRM System (ASP.NET Core Module V2, in-process hosting).
  Requires the ".NET 10 Hosting Bundle" on the server. Published as win-x64 framework-dependent: CrmSystem.exe is the host.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath=".\CrmSystem.exe" arguments="" hostingModel="inprocess"
                  stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 20 MB: Excel import uploads -->
          <requestLimits maxAllowedContentLength="20971520" />
          <hiddenSegments>
            <add segment="App_Data" />
            <add segment="logs" />
          </hiddenSegments>
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
